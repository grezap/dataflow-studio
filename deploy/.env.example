# DataFlow Studio — runtime configuration for docker-compose. Copy to .env and fill from your platform
# (in the lab these come from Vault). The Kafka mTLS PEMs are files: put them in deploy/secrets/ and keep
# the in-container paths below. Nothing here is committed — .env and secrets/ are gitignored.

# OLTP source (SQL Server AG listener) — used by the Seed console + the Oltp migration.
DFS_SQL_CONN=Server=192.168.70.17;Database=OltpDb;User ID=sa;Password=CHANGEME;Encrypt=True;TrustServerCertificate=True
DFS_OLTP_CONNECTION=Server=192.168.70.17;Database=OltpDb;User ID=sa;Password=CHANGEME;Encrypt=True;TrustServerCertificate=True

# Kafka (backplane bootstrap) + mTLS PEM paths (mounted from deploy/secrets/).
DFS_KAFKA_BOOTSTRAP=192.168.10.21:9092,192.168.10.22:9092,192.168.10.23:9092
DFS_KAFKA_CA=/secrets/kafka-ca.pem
DFS_KAFKA_CERT=/secrets/kafka-cert.pem
DFS_KAFKA_KEY=/secrets/kafka-key.pem
DFS_SR_URL=https://192.168.10.91:8081

# Sinks.
DFS_STARROCKS_CONNECTION=Server=192.168.70.31;Port=9030;User ID=root;Password=CHANGEME;SslMode=None;AllowPublicKeyRetrieval=true
DFS_CLICKHOUSE_CONNECTION=Host=192.168.70.44;Port=8443;Protocol=https;Database=analytics;Username=default;Password=CHANGEME

# Observability + lineage (optional; omit to run without export).
DFS_OTLP_ENDPOINT=https://192.168.70.182:4318
DFS_MARQUEZ_ENDPOINT=https://192.168.70.127
