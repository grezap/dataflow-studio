<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DataFlowStudio.Trace</RootNamespace>
    <AssemblyName>DataFlowStudio.Trace</AssemblyName>
    <!-- Runnable demo tool (not a library); no XML-doc requirement. Not an AOT path — it pulls in
         Confluent.Kafka + Avro (reflection/native), the documented AOT relaxation for the Avro
         serdes (ADR-0003). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Label="nexus-shared + SQL client — the pipeline building blocks">
    <PackageReference Include="Nexus.Primitives" />
    <PackageReference Include="Nexus.Kafka" />
    <PackageReference Include="Nexus.Avro" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup Label="OpenLineage → Marquez for Face 5 (E16) + its config/logging host plumbing">
    <ProjectReference Include="../DataFlowStudio.Lineage/DataFlowStudio.Lineage.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
